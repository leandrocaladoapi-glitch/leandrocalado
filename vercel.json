{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/books/harness-engineering-ai-coding-agents",
      "destination": "/books/harness-engineering-ai-coding-agents/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/start-here",
      "destination": "/start-here/index.html"
    },
    {
      "source": "/books",
      "destination": "/books/index.html"
    },
    {
      "source": "/articles",
      "destination": "/articles/index.html"
    },
    {
      "source": "/consulting",
      "destination": "/consulting/index.html"
    },
    {
      "source": "/ai-agents",
      "destination": "/ai-agents/index.html"
    },
    {
      "source": "/data-engineering",
      "destination": "/data-engineering/index.html"
    },
    {
      "source": "/safe-ai",
      "destination": "/safe-ai/index.html"
    },
    {
      "source": "/automation",
      "destination": "/automation/index.html"
    },
    {
      "source": "/((?!assets|favicon.*|sitemap.*|robots.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
